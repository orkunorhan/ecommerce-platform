    {
      "name": "Authentication",
      "item": [
        {
          "name": "01 - Get Roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is valid JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is an array\", function () {\r",
                  "    const roles = pm.response.json();\r",
                  "    pm.expect(roles).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Exactly three roles are returned\", function () {\r",
                  "    const roles = pm.response.json();\r",
                  "    pm.expect(roles).to.have.lengthOf(3);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Every role contains id, name and code\", function () {\r",
                  "    const roles = pm.response.json();\r",
                  "\r",
                  "    roles.forEach((role) => {\r",
                  "        pm.expect(role).to.have.all.keys(\"id\", \"name\", \"code\");\r",
                  "        pm.expect(role.id).to.be.a(\"number\");\r",
                  "        pm.expect(role.name).to.be.a(\"string\");\r",
                  "        pm.expect(role.code).to.be.a(\"string\");\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Admin, store and customer roles exist\", function () {\r",
                  "    const roles = pm.response.json();\r",
                  "    const codes = roles.map((role) => role.code);\r",
                  "\r",
                  "    pm.expect(codes).to.include.members([\r",
                  "        \"admin\",\r",
                  "        \"store\",\r",
                  "        \"customer\",\r",
                  "    ]);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Role ids match the current API contract\", function () {\r",
                  "    const roles = pm.response.json();\r",
                  "\r",
                  "    const admin = roles.find((role) => role.code === \"admin\");\r",
                  "    const store = roles.find((role) => role.code === \"store\");\r",
                  "    const customer = roles.find(\r",
                  "        (role) => role.code === \"customer\",\r",
                  "    );\r",
                  "\r",
                  "    pm.expect(admin.id).to.eql(1);\r",
                  "    pm.expect(store.id).to.eql(2);\r",
                  "    pm.expect(customer.id).to.eql(3);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "roles"
              ]
            }
          },
          "response": []
        },
